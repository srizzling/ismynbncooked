---
/** "Share this" row: opens the social card image and copies the page link. */
interface Props {
  imagePath: string;
  pagePath: string;
  label?: string;
  /** Optional chart-only page; adds a "Copy embed code" button for sites that allow iframes */
  embedPath?: string;
}
const { imagePath, pagePath, label = 'Share this', embedPath } = Astro.props;
const origin = Astro.site ?? Astro.url.origin;
const imageUrl = new URL(imagePath, origin).href;
const pageUrl = new URL(pagePath, origin).href;
const embedCode = embedPath
  ? `<iframe src="${new URL(embedPath, origin).href}" width="100%" height="520" style="border:0;border-radius:12px;background:#0a0a0a" loading="lazy" title="NBN price trends"></iframe>`
  : null;
---

<div class="flex flex-wrap items-center gap-2 text-sm" data-share-bar>
  <span class="text-neutral-500">{label}:</span>
  <a href={imageUrl} target="_blank" rel="noopener" download
     class="inline-flex items-center gap-1.5 bg-surface-raised border border-surface-border rounded-lg px-3 py-1.5 text-neutral-200 hover:border-accent transition-colors">
    Open image
  </a>
  <button type="button" data-copy={pageUrl}
          class="inline-flex items-center gap-1.5 bg-surface-raised border border-surface-border rounded-lg px-3 py-1.5 text-neutral-200 hover:border-accent transition-colors">
    Copy link
  </button>
  {embedCode && (
    <button type="button" data-copy={embedCode}
            class="inline-flex items-center gap-1.5 bg-surface-raised border border-surface-border rounded-lg px-3 py-1.5 text-neutral-200 hover:border-accent transition-colors">
      Copy embed code
    </button>
  )}
  <a href={`https://www.reddit.com/submit?url=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener"
     class="inline-flex items-center gap-1.5 bg-surface-raised border border-surface-border rounded-lg px-3 py-1.5 text-neutral-200 hover:border-accent transition-colors">
    Post to Reddit
  </a>
  <span class="text-xs text-neutral-600">Pasting the link anywhere shows the image automatically.</span>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-share-bar] [data-copy]').forEach(btn => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        const prev = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => { btn.textContent = prev; }, 1500);
      } catch {}
    });
  });
</script>
