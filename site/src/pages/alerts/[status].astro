---
import Base from '../../layouts/Base.astro';

const { status } = Astro.params;
const tier = Astro.url.searchParams.get('tier') ?? '';
const copy: Record<string, { title: string; body: string }> = {
  confirmed: { title: "You're on the list", body: `We'll email you when ${tier ? tier.toUpperCase() : 'your tier'} gets meaningfully cheaper or when your promo is about to end. That's it.` },
  unsubscribed: { title: 'Unsubscribed', body: "Your email has been deleted. No hard feelings." },
  invalid: { title: 'That link has expired', body: 'The confirmation or unsubscribe link is no longer valid. If you still want alerts, sign up again from any tier page.' },
};
const page = status ? copy[status] : undefined;
if (!page) return new Response(null, { status: 404 });
---

<Base title={`${page.title} — Am I Getting Rorted?`} description={page.body} noindex>
  <section class="text-center py-20 max-w-xl mx-auto">
    <h1 class="font-display font-bold text-3xl mb-3">{page.title}</h1>
    <p class="text-neutral-400 mb-8">{page.body}</p>
    <a href={tier && /^(nbn|opticomm)-\d+-\d+$/.test(tier) ? `/${tier}` : '/'} class="inline-block bg-accent text-black font-medium rounded-lg px-5 py-2.5 hover:bg-orange-400 transition-colors">
      {tier ? `Back to ${tier.toUpperCase()}` : 'Back to all tiers'}
    </a>
  </section>
</Base>
