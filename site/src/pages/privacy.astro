---
import Base from '../layouts/Base.astro';

const adsEnabled = Boolean(import.meta.env.PUBLIC_ADSENSE_SLOT_HOME || import.meta.env.PUBLIC_ADSENSE_SLOT_TIER);
const updated = '19 September 2026';
---

<Base
  title="Privacy — Am I Getting Rorted?"
  description="What this site stores, what it doesn't, and how advertising works on amigettingrorted.au."
  canonicalPath="/privacy"
>
  <div class="max-w-3xl mx-auto">
    <a href="/" class="inline-flex items-center gap-1 text-neutral-400 hover:text-white text-sm mb-6 transition-colors">
      &larr; Home
    </a>

    <h1 class="text-4xl sm:text-5xl font-display font-bold mb-2">Privacy</h1>
    <p class="text-neutral-500 text-sm mb-10">Last updated {updated}</p>

    <div class="space-y-8 text-neutral-300 leading-relaxed">
      <section>
        <h2 class="font-display font-bold text-2xl text-white mb-3">The short version</h2>
        <p>
          There are no accounts, no sign-ups and no tracking pixels of our own. The plan you enter into the
          checker is saved in your browser only. The site is hosted on Cloudflare, which sees the same request
          logs any web host sees.
        </p>
      </section>

      <section>
        <h2 class="font-display font-bold text-2xl text-white mb-3">What is stored in your browser</h2>
        <p>
          When you enter your current plan price, provider or promo details, they are saved in your browser's
          local storage so the rating survives a refresh. Nothing is sent to us. Clear your browser's site data
          to remove it.
        </p>
      </section>

      <section>
        <h2 class="font-display font-bold text-2xl text-white mb-3">Share links</h2>
        <p>
          A share link encodes the tier and price you chose into the URL itself. Anyone with the link can see
          those values. We do not store who created or opened a link.
        </p>
      </section>

      <section>
        <h2 class="font-display font-bold text-2xl text-white mb-3">Plan submissions</h2>
        <p>
          Submitting a missing plan opens a public pull request on GitHub containing the plan and CIS URLs you
          provide. Do not include personal details in the notes field.
        </p>
      </section>

      <section>
        <h2 class="font-display font-bold text-2xl text-white mb-3">Advertising</h2>
        {adsEnabled ? (
          <>
            <p>
              A small number of display ads help cover hosting and data-scraping costs. They are served by Google
              AdSense, which may use cookies and similar technologies to show ads based on your visits to this and
              other sites. Google's use of advertising cookies is described in
              <a href="https://policies.google.com/technologies/ads" class="underline hover:text-white" target="_blank" rel="noopener">Google's advertising policy</a>.
              You can opt out of personalised advertising at
              <a href="https://www.google.com/settings/ads" class="underline hover:text-white" target="_blank" rel="noopener">Google Ads Settings</a>.
            </p>
            <p class="mt-3">
              Ads never affect the rankings. Plans are ordered by price and price alone, and there are no
              affiliate links or sponsored placements.
            </p>
          </>
        ) : (
          <p>
            This site does not currently show ads. If that changes, this section will describe exactly which
            provider serves them and how to opt out. Rankings will never be influenced by advertising.
          </p>
        )}
      </section>

      <section>
        <h2 class="font-display font-bold text-2xl text-white mb-3">Contact</h2>
        <p>
          Questions or corrections: open an issue on
          <a href="https://github.com/srizzling/ismynbncooked" class="underline hover:text-white" target="_blank" rel="noopener">GitHub</a>.
        </p>
      </section>
    </div>
  </div>
</Base>
