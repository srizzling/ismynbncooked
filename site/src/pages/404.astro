---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Am I Getting Rorted?" description="That page doesn't exist. Head back to the NBN plan comparison." noindex>
  <section class="text-center py-20 max-w-xl mx-auto">
    <p class="text-accent font-display font-bold text-6xl mb-4">404</p>
    <h1 class="font-display font-bold text-3xl mb-3">That page is cooked</h1>
    <p class="text-neutral-400 mb-8">
      Nothing lives here. Tier pages look like <code class="text-neutral-200">/nbn-100-20</code> or
      <code class="text-neutral-200">/opticomm-500-50</code>.
    </p>
    <a href="/" class="inline-block bg-accent text-black font-medium rounded-lg px-5 py-2.5 hover:bg-orange-400 transition-colors">
      Back to all tiers
    </a>
  </section>
</Base>
