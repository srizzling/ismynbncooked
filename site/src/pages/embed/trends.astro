---
import TrendsChart from '../../components/TrendsChart';
import { loadTrends } from '../../lib/trends';

const { series, firstDate, lastDate } = await loadTrends(Astro.locals);
const selected = (Astro.url.searchParams.get('tiers') ?? 'nbn-50-20,nbn-100-20,nbn-500-50,nbn-1000-50').split(',').map(s => s.trim()).filter(Boolean);
const compact = series.map(s => ({ key: s.key, label: s.label, points: s.points.map(p => ({ date: p.date, cheapest: p.cheapest, average: p.average })) }));
const fmt = (d: string) => new Date(d).toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });
---

<!doctype html>
<html lang="en-AU" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>NBN price trends — Am I Getting Rorted?</title>
    <style is:global>@import '../../styles/global.css';</style>
  </head>
  <body class="bg-surface text-white p-3">
    <div class="flex items-baseline justify-between gap-3 mb-2">
      <span class="font-display font-bold text-sm">NBN prices, {fmt(firstDate)} to {fmt(lastDate)}</span>
      <a href="/trends" target="_blank" rel="noopener" class="text-xs text-accent hover:underline">amigettingrorted.au/trends ↗</a>
    </div>
    <TrendsChart client:load series={compact.filter(s => selected.includes(s.key))} defaultSelected={selected} catalogue={compact.map(s => ({ key: s.key, label: s.label }))} dataId="trends-data" />
    <script type="application/json" id="trends-data" set:html={JSON.stringify(compact)} />
  </body>
</html>
