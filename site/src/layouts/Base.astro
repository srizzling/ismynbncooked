---
import { ADSENSE_CLIENT, SUPPORT_URL, GITHUB_URL } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogImage?: string;
  /** Keep the page out of search results (share cards, error pages). */
  noindex?: boolean;
}

const {
  title,
  description = "Compare every Australian NBN internet plan. See cheapest prices across all ISPs for NBN 25, 50, 100, 250, 1000 and find out if your provider is ripping you off.",
  canonicalPath,
  jsonLd,
  ogImage,
  noindex = false,
} = Astro.props;

const origin = Astro.site ?? Astro.url.origin;
const canonicalUrl = canonicalPath
  ? new URL(canonicalPath, origin).href
  : Astro.url.href;
const ogImageUrl = ogImage ?? new URL('/og-share.png', origin).href;
---

<!doctype html>
<html lang="en-AU" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="google-adsense-account" content={ADSENSE_CLIENT} />
    <meta name="commission-factory-verification" content="1670e632b717473598120559e3ed0c6b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <link rel="preload" href="/fonts/ClashDisplay-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeneralSans-Regular.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content="Am I Getting Rorted?" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <header class="max-w-6xl mx-auto px-4 pt-4 pb-2 flex items-center justify-between">
      <a href="/" class="text-sm font-display font-bold text-neutral-300 hover:text-white transition-colors">
        amigettingrorted.au
      </a>
      <nav class="flex items-center gap-4 text-sm text-neutral-500">
        <a href="/providers" class="hover:text-accent transition-colors">Providers</a>
        <a href="/reports" class="hover:text-accent transition-colors">Price reports</a>
        <a href="/trends" class="hover:text-accent transition-colors">Trends</a>
        <a href="/how-it-works" class="hover:text-accent transition-colors hidden sm:inline">How the rating works</a>
      </nav>
    </header>
    <main class="max-w-6xl mx-auto px-4 py-6 sm:py-10">
      <slot />
    </main>
    <footer class="max-w-6xl mx-auto px-4 py-8 border-t border-surface-border text-neutral-500 text-sm space-y-3">
      <p>
        Data sourced from <a href="https://www.netbargains.com.au" class="underline hover:text-white" target="_blank" rel="noopener">NetBargains</a>
        plus community-submitted providers.
        Prices, availability, and plan details may be out of date, inaccurate, or wrong.
        Always check the provider's website before signing up. This site does not guarantee plan
        availability and is <span class="text-neutral-300">not financial advice</span>.
      </p>
      <p>
        This site is <span class="text-neutral-300 font-medium">not associated with any NBN provider, RSP, or NBN Co</span>.
        It's just built by a bloke who's trying to buy a house and reckons everyone's paying too much for internet.
      </p>
      <p>
        <span class="text-neutral-300 font-medium">Rankings are by price and nothing else.</span>
        No sponsored placements. Some "Go to provider" buttons are labelled referral links, which pay a small fee if you
        sign up and change nothing about where a plan sits. A single small ad at the bottom of some pages and
        {SUPPORT_URL && (<><a href={SUPPORT_URL} class="underline hover:text-white" target="_blank" rel="noopener">the odd coffee</a> </>)}
        cover hosting and scraping. If you want to support the data itself, chuck a few bucks at
        <a href="https://www.netbargains.com.au" class="underline hover:text-white" target="_blank" rel="noopener">NetBargains</a> —
        the legends who actually maintain it.
      </p>
      <p>
        <a href="/providers" class="underline hover:text-white">All providers</a> ·
        <a href="/reports" class="underline hover:text-white">Monthly price reports</a> ·
        <a href="/trends" class="underline hover:text-white">Price trends</a> ·
        <a href="/submit" class="underline hover:text-white">Submit a missing plan</a> ·
        <a href="/llms.txt" class="underline hover:text-white">MCP server for AI agents</a> ·
        <a href={GITHUB_URL} class="underline hover:text-white" target="_blank" rel="noopener">Source</a> ·
        <a href="/privacy" class="underline hover:text-white">Privacy</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
