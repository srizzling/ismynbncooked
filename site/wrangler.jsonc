{
  "name": "ismynbncooked",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "r2_buckets": [
    {
      "binding": "DATA_BUCKET",
      "bucket_name": "ismynbncooked-data"
    }
  ],
  "vars": {
    "SUBMISSIONS_ENABLED": "true"
  }
  // GITHUB_TOKEN set via `wrangler secret put GITHUB_TOKEN`
}
