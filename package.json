{
  "name": "ismynbncooked",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter ismynbncooked-site dev",
    "build": "pnpm --filter ismynbncooked-site build",
    "preview": "pnpm --filter ismynbncooked-site preview",
    "deploy:site": "pnpm --filter ismynbncooked-site deploy",
    "deploy:workers": "pnpm --filter './workers/**' exec wrangler deploy",
    "deploy:all": "pnpm deploy:workers && pnpm deploy:site",
    "test": "pnpm --filter ismynbncooked-site test",
    "test:e2e": "pnpm --filter ismynbncooked-site test:e2e",
    "test:visual": "pnpm --filter ismynbncooked-site test:visual"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "undici": "^7.29.1",
      "h3": "^1.15.10",
      "devalue": "^5.9.3",
      "svgo": "^4.1.0",
      "postcss": "^8.5.23",
      "js-yaml": "^4.3.2",
      "sharp": "^0.35.4",
      "smol-toml": "^1.7.1",
      "baseline-browser-mapping": "^2.11.0",
      "browserslist": "^4.28.7",
      "nanoid": "^3.3.18",
      "fflate": "^0.7.5",
      "postcss-selector-parser": "^6.1.3",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "defu@<=6.1.4": "^6.1.5",
      "esbuild@<0.28.1": "^0.28.1",
      "@babel/core@<7.29.6": "^7.29.6",
      "http-cache-semantics@<=4.2.0": "^4.3.0"
    }
  }
}
